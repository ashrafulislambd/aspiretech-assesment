# ── AI Provider ───────────────────────────────────────────────────────────────
# Get yours at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=AIza...

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Path to your Google service account JSON file (mounted into the container)
# Steps to set up:
#   1. Go to Google Cloud Console → IAM & Admin → Service Accounts
#   2. Create a service account, download the JSON key
#   3. Place the file in the project root as google_credentials.json
#   4. Share your Google Sheet with the service account email (Editor role)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/google_credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ── Slack Webhooks ─────────────────────────────────────────────────────────────
# Steps to set up:
#   1. Go to https://api.slack.com/apps → Create New App → From Scratch
#   2. Enable Incoming Webhooks, add webhooks for each channel
SLACK_WEBHOOK_URL_DEFAULT=https://hooks.slack.com/services/...  # Warm + Cold leads (#sales-leads)
SLACK_WEBHOOK_URL_URGENT=https://hooks.slack.com/services/...   # Hot leads  (#sales-urgent)

# ── Qdrant (Vector Memory) ─────────────────────────────────────────────────────
# These defaults match the docker-compose service name and port — no change needed
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Pipeline Thresholds ────────────────────────────────────────────────────────
# Messages shorter than this are treated as Low-Context and skip AI scoring
MIN_MESSAGE_LENGTH=10
# Cosine similarity above this value counts as a "similar past lead" match
SIMILARITY_THRESHOLD=0.82
